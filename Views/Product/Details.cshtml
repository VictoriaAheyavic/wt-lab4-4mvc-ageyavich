@model wt_lab4_4mvc_ageyavich.Models.Product
@{
    ViewData["Title"] = $"Товар: {Model.Name}";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Главная</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Index">Товары</a>
            </li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="badge bg-secondary">ID: @Model.Id</span>
                        @if (Model.IsAvailable)
                        {
                            <span class="badge bg-success fs-6">В наличии</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">Нет в наличии</span>
                        }
                    </div>

                    <h1 class="display-5 fw-bold mb-3">@Model.Name</h1>
                    <p class="text-muted fs-5 mb-4">@Model.Category</p>

                    <dl class="row">
                        <dt class="col-sm-3">Цена:</dt>
                        <dd class="col-sm-9 fw-bold fs-4 text-primary">
                            @Model.Price.ToString("N0") ₽
                        </dd>

                        <dt class="col-sm-3">Остаток:</dt>
                        <dd class="col-sm-9">@Model.Stock шт.</dd>

                        <dt class="col-sm-3">Описание:</dt>
                        <dd class="col-sm-9">@Model.Description</dd>
                    </dl>

                    <hr />

                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-secondary">
                            ← Назад к списку
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id"
                           class="btn btn-warning">
                            ✏ Редактировать
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>