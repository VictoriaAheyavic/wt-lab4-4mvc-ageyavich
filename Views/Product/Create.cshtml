@model wt_lab4_4mvc_ageyavich.Models.Product
@{
    ViewData["Title"] = "Добавление товара";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-4">Добавление товара</h2>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Название
                            </label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name"
                                  class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Category" class="form-label fw-semibold">
                                    Категория
                                </label>
                                <input asp-for="Category" class="form-control" />
                                <span asp-validation-for="Category"
                                      class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-semibold">
                                    Цена
                                </label>
                                <input asp-for="Price" class="form-control" />
                                <span asp-validation-for="Price"
                                      class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Stock" class="form-label fw-semibold">
                                    Остаток
                                </label>
                                <input asp-for="Stock" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3 d-flex align-items-end">
                                <div class="form-check">
                                    <input asp-for="IsAvailable" class="form-check-input" />
                                    <label asp-for="IsAvailable" class="form-check-label">
                                        В наличии
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">
                                Описание
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                💾 Сохранить
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                Назад
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}